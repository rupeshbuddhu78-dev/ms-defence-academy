PORT=5000
NODE_ENV=development

# MongoDB - Use MongoDB Atlas or secure self-hosted instance
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ms_defence_academy?retryWrites=true&w=majority

# JWT - Generate a strong random secret (min 32 chars)
JWT_SECRET=your_super_strong_jwt_secret_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS
CLIENT_URL=http://localhost:3000

# FCM (optional - for push notifications)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Upload limits
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=10

# SMTP (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
